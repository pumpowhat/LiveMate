PORT=4000
WEB_ORIGIN=http://localhost:3000
# Bắt buộc ở production (PostgreSQL). Nếu bỏ trống khi chạy local sẽ dùng bộ nhớ in-memory.
DATABASE_URL=postgresql://user:pass@localhost:5432/livemate
PUBLIC_WEB_URL=http://localhost:3000

# Bảo mật phiên đăng nhập người bán và socket-token ngắn hạn (bắt buộc ở production: chuỗi ngẫu nhiên >= 32 ký tự)
AUTH_SECRET=
# Tài khoản demo được seed tự động cho phòng DEMO (DEMO_SELLER_PASSWORD bắt buộc ở production: >= 12 ký tự và khác livemate-demo)
DEMO_SELLER_EMAIL=demo@livemate.vn
DEMO_SELLER_PASSWORD=livemate-demo

# LLM — điền một hoặc cả hai để chạy `pnpm --filter @livemate/server eval`
# Danh sách model, model đầu là ưu tiên; lỗi 429/503 tự chuyển model kế tiếp. Gói miễn phí: 15 request/phút mỗi model.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
GEMINI_RPM=15
OPENAI_API_KEY=
OPENAI_MODEL=

# VietQR — tài khoản nhận tiền của shop demo
VIETQR_BANK_BIN=970436
VIETQR_ACCOUNT_NUMBER=

# Facebook — Fanpage của nhóm, app ở chế độ Development
# FB_GRAPH_VERSION: phiên bản Graph API hiện hành, ví dụ v23.0 (xem developers.facebook.com/docs/graph-api/changelog)
FB_GRAPH_VERSION=
FB_PAGE_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
# Dùng origin của frontend (/api/facebook/callback) để giữ cookie phiên same-origin khi qua Next rewrite.
FB_REDIRECT_URI=http://localhost:3000/api/facebook/callback

# Khóa cho POST /api/ingest (extension đọc live thật). Đặt chuỗi ngẫu nhiên khi deploy.
INGEST_KEY=

# Chỉ khi chạy local: bật /api/dev/*, /api/ingest không cần key, luồng DEMO cũ và seller "demo". Mặc định bật khi NODE_ENV khác production.
# DEV_ROUTES=1

# Gom lô bình luận trước khi gọi LLM
PIPELINE_BATCH_WINDOW_MS=1500
PIPELINE_MAX_BATCH=40
