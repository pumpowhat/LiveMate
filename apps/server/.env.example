PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://user:pass@localhost:5432/livemate
PUBLIC_WEB_URL=http://localhost:3000

# LLM — điền một hoặc cả hai để chạy `pnpm --filter @livemate/server eval`
# Tên model lấy ở trang tài liệu của từng nhà cung cấp (bản Flash / mini mới nhất).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# VietQR — tài khoản nhận tiền của shop demo
VIETQR_BANK_BIN=970436
VIETQR_ACCOUNT_NUMBER=

# Facebook — Fanpage của nhóm, app ở chế độ Development
# FB_GRAPH_VERSION: phiên bản Graph API hiện hành, ví dụ v23.0 (xem developers.facebook.com/docs/graph-api/changelog)
FB_GRAPH_VERSION=
FB_PAGE_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_REDIRECT_URI=http://localhost:4000/api/facebook/callback
